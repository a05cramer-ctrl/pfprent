# ===== pfpRent bot settings =====
# On Railway: Service > Variables. Locally: copy this file to .env

# --- required ---
DATA_DIR=/data                      # the Railway volume (database + treasury key live here)
PFP_MINT=                           # the $PFP contract address (CA)
RPC_URL=                            # Solana RPC, e.g. https://mainnet.helius-rpc.com/?api-key=YOUR_KEY (free at helius.dev)
ADMIN_WALLETS=                      # your wallet address(es), comma separated: they can log in to /admin
ADMIN_KEY=                          # backup admin password (long + random)
PUBLIC_URL=                         # this bot's https URL, e.g. https://pfprent.up.railway.app

# --- recommended ---
TWITTERAPI_KEY=                     # twitterapi.io key: reliable profile checks + retweet raids. Without it the free api.fxtwitter.com is used
TICKER=PFP

# --- optional ---
TREASURY_SECRET=                    # use your own wallet as the treasury (base58 private key or [..] array). Empty = the bot makes one and you back it up from /admin
X_CLIENT_ID=                        # "Sign in with X" (OAuth 2.0 app from developer.x.com). Empty = users verify by posting a code
X_CLIENT_SECRET=
X_BEARER=                           # official X API bearer token (alternative to TWITTERAPI_KEY)
SITE_URL=                           # only if the site lives somewhere else (e.g. Vercel): its https URL
CORS_ORIGINS=                       # extra site origins allowed to call the API, comma separated
SESSION_SECRET=                     # empty = generated and stored in DATA_DIR
PRIORITY_FEE_MICROLAMPORTS=50000
SOL_RESERVE=0.05                    # the treasury never spends below this much SOL

# --- rules (all of these can be changed live from /admin) ---
POOL_MODE=percent                   # percent | fixed | fees
POOL_PERCENT=1                      # percent mode: % of the treasury's free $PFP paid out each hour
POOL_FIXED=0                        # fixed mode: $PFP paid out each hour
FEES_BUY_PERCENT=90                 # fees mode: % of claimed creator-fee SOL that buys $PFP
MIN_FOLLOWERS=50
MIN_ACCOUNT_DAYS=30
MIN_HOLD=0                          # must hold this much $PFP to get paid (0 = off)
BANDS=0:1,1000:2,10000:4,100000:8   # followers:weight
NAME_TAG=$PFP
NAME_TAG_BONUS=0.5
STREAK_BONUS_PER_HOUR=0.02
STREAK_BONUS_MAX=0.5
MAX_SHARE_PERCENT=5
PAYOUT_MIN=1
PAYOUT_EVERY_MINUTES=60
CHECK_EVERY_MINUTES=20
EPOCH_MINUTES=60
